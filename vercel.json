{
  "version": 2,
  "name": "blackai",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/**/*.js": {
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "routes": [
    { "src": "/health", "dest": "/api/health.js" },
    { "src": "/api/ai/chat", "dest": "/api/chat.js" },
    { "src": "/api/v1/chat", "dest": "/api/chat.js" },
    { "src": "/api/v1/fetch-url", "dest": "/api/fetch-url.js" },
    { "src": "/api/ai/stream", "dest": "/api/stream.js" },
    { "src": "/api/ai/image", "dest": "/api/image.js" },
    { "src": "/api/image", "dest": "/api/image.js" },
    { "src": "/api/v1/image/generate", "dest": "/api/image.js" },
    { "src": "/api/ai/health", "dest": "/api/health.js" },
    { "src": "/api/v1/health", "dest": "/api/health.js" },
    { "src": "/api/v1/providers", "dest": "/api/providers.js" },
    { "src": "/api/search", "dest": "/api/search.js" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
