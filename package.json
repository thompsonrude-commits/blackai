{
  "name": "blackai",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:backend": "node scripts/local-functions-server.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rimraf dist server.js",
    "lint": "tsc --noEmit",
    "deploy": "npm run build && vercel --prod",
    "test": "node scripts/run-tests.mjs",
    "test:connectors": "node --import tsx/esm --test core/integrations/connectorPlatform.test.ts",
    "test:security": "node --import tsx/esm --test core/security/securityPlatform.test.ts",
    "test:operations": "node --import tsx/esm --test core/operations/operationsPlatform.test.ts",
    "test:release": "node --import tsx/esm --test core/release/releasePlatform.test.ts",
    "test:backend": "npm --prefix functions run test",
    "test:all": "npm test && npm run test:backend",
    "validate": "node scripts/validate.mjs",
    "validate:ci": "node scripts/validate.mjs --ci",
    "secret:scan": "node scripts/secret-scan.mjs"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.14",
    "@types/d3": "^7.4.3",
    "@types/leaflet": "^1.9.21",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^5.0.4",
    "axios": "^1.16.1",
    "cld3-asm": "^1.0.0",
    "compromise": "^14.0.0",
    "d3": "^7.9.0",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "firebase": "^12.13.0",
    "firebase-admin": "^13.10.0",
    "framer-motion": "^12.40.0",
    "franc": "^6.1.0",
    "html2canvas": "^1.4.1",
    "i18next": "^23.0.0",
    "jszip": "^3.10.1",
    "kokoro-js": "^1.2.1",
    "langchain": "^1.4.2",
    "langs": "^2.0.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "natural": "^6.2.0",
    "openai": "^6.39.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-i18next": "^13.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.15.1",
    "remark-gfm": "^4.0.1",
    "socket.io": "^4.8.3",
    "tesseract.js": "^7.0.0",
    "topojson-client": "^3.1.0",
    "vite": "^6.2.3",
    "ws": "^8.21.0",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "playwright": "^1.62.1",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.10"
  }
}
