# GROQ_KEY: Required for AI chat and vision routing through Groq.
# Get a free key at https://console.groq.com
GROQ_KEY="your_groq_key_here"

# TAVILY_KEY: Required for web search grounding in language discovery.
# Get a free key at https://app.tavily.com (1,000 free searches/month)
TAVILY_KEY="your_tavily_key_here"

# HUGGINGFACE_TOKEN: For watermark-free image generation
# Get a free key at https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN="your_huggingface_token_here"

# REPLICATE_API_TOKEN: For AI image upscaling (Real-ESRGAN)
# Get a free key at https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN="your_replicate_token_here"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ComfyUI configuration (do NOT commit real secrets)
COMFYUI_ENABLED=true
IMAGE_PROVIDER=comfyui

COMFYUI_MODE=local
COMFYUI_LOCAL_ENDPOINT=http://127.0.0.1:8188
COMFYUI_REMOTE_ENDPOINT=

COMFYUI_API_KEY=
COMFYUI_TIMEOUT_MS=300000

# Google Cloud / GPU configuration (for operator-run deployments)
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GPU_TYPE=
GPU_COUNT=1

# ComfyUI endpoint (production/dev)
COMFYUI_ENDPOINT=
COMFYUI_API_KEY=
MODEL_DIRECTORY=/models
OUTPUT_DIRECTORY=/output

# Job queue and safety limits
MAX_CONCURRENT_JOBS=1
MAX_QUEUE_LENGTH=20
MAX_IMAGE_WIDTH=2048
MAX_IMAGE_HEIGHT=2048
MAX_STEPS=100
MAX_BATCH_SIZE=4
JOB_TIMEOUT_MS=900000
IDLE_TIMEOUT_MS=600000

# Admin bootstrap key for local worker trigger (development only). Use Cloud Scheduler/Cloud Tasks + service identity in production.
ADMIN_API_KEY=
MASTER_ADMIN_EMAIL=you@your-domain.com



# Google AdSense monetization (optional)
# Get your Publisher ID from https://www.google.com/adsense
# Format: ca-pub-1234567890123456
VITE_GOOGLE_ADSENSE_ID=ca-pub-0000000000000000

# Server-side token for Alibaba Z-Image through ModelScope
MODELSCOPE_TOKEN=
