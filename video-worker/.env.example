# Hugging Face Space runtime configuration
WAN_T2V_MODEL=Wan-AI/Wan2.1-T2V-1.3B
WAN_I2V_MODEL=Wan-AI/Wan2.1-I2V-14B-480P
VIDEO_MAX_DURATION=10
VIDEO_MAX_WIDTH=1280
VIDEO_MAX_HEIGHT=720
VIDEO_MAX_CONCURRENCY=1
OUTPUT_DIR=/data/outputs

# The 9JA backend configuration is separate and must remain server-side:
# VIDEO_WORKER_URL=https://<actual-space-name>.hf.space
# VIDEO_WORKER_TOKEN=<optional-private-worker-token>
