rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function isMasterAdmin() {
      return isSignedIn() && request.auth.token.email == 'mckpedersen@gmail.com';
    }

    // ── Default deny ───────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }

    // ── User Memory (long-term AI memory per user) ─────────────────────────
    match /user_memory/{userId} {
      allow read, write: if isOwner(userId);
    }

    // ── Chat History (conversations saved to Firestore) ────────────────────
    match /chat_sessions/{sessionId} {
      allow read, write: if isSignedIn() &&
        request.auth.uid == resource.data.userId;
      allow create: if isSignedIn() &&
        request.auth.uid == request.resource.data.userId;
    }

    // ── AI Feedback (ratings on AI responses) ─────────────────────────────
    match /ai_feedback/{feedbackId} {
      allow create: if isSignedIn() &&
        request.auth.uid == request.resource.data.userId;
      allow read: if isSignedIn() &&
        request.auth.uid == resource.data.userId;
    }

    // ── AI Corrections (user-submitted corrections for AI learning) ────────
    match /ai_corrections/{correctionId} {
      allow create: if isSignedIn() &&
        request.auth.uid == request.resource.data.userId;
      allow read: if isSignedIn() &&
        request.auth.uid == resource.data.userId;
      // Admin can read all and approve/reject
      allow read, write: if isMasterAdmin();
    }

    // ── Personal Vocabulary (language learning per user) ──────────────────
    match /users/{userId}/personalVocab/{vocabId} {
      allow read, write: if isOwner(userId);
    }

    // ── Languages Repository ───────────────────────────────────────────────
    match /languages/{languageId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // ── Developer Accounts ─────────────────────────────────────────────────
    match /lexiconDevelopers/{devId} {
      allow read: if true;
      allow write: if isMasterAdmin();
    }

    // ── Core Vocabulary Audio ──────────────────────────────────────────────
    match /coreVocabAudio/{audioId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // ── Community Vocabulary ───────────────────────────────────────────────
    match /communityVocab/{vocabId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // ── AI Training Studio ─────────────────────────────────────────────────
    match /aiTraining/{entryId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // ── Request Logs (Cloud Functions write via admin SDK — no client access) ──
    match /ai_request_logs/{logId} {
      allow read: if isMasterAdmin();
      allow write: if false; // server only
    }

    // ── Orchestrator History (server-only) ─────────────────────────────────
    match /orchestrator_history/{recordId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ── Global Knowledge (public knowledge base) ───────────────────────────
    match /global_knowledge/{entryId} {
      allow read: if true; // public read
      allow write: if isSignedIn(); // any signed-in user can contribute
    }

    // ── User Knowledge (personal knowledge entries) ────────────────────────
    match /user_knowledge/{entryId} {
      allow read, write: if isSignedIn() &&
        request.auth.uid == resource.data.userId;
      allow create: if isSignedIn() &&
        request.auth.uid == request.resource.data.userId;
    }

    // ── Analytics Events (server writes, admin reads) ──────────────────────
    match /analytics_events/{eventId} {
      allow create: if isSignedIn(); // users can log their own events
      allow read: if isMasterAdmin(); // only admin can read analytics
    }

    // ── Generated Images (user-owned records written by server admin SDK) ──
    match /image_generations/{genId} {
      // Allow owner to read their generation record
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      // Allow master admin to read all
      allow read: if isMasterAdmin();
      // Writes are server-only via admin SDK; deny from client
      allow write: if false;
    }
  }
}
