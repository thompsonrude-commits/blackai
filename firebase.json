{
  "firestore": [
    {
      "database": "(default)",
      "rules": "firestore.rules"
    },
    {
      "database": "ai-studio-8c2c3e66-6109-4357-af6f-43f60f64bb67",
      "rules": "firestore.rules"
    }
  ],
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "blackai-ai",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "hosting": {
    "target": "blackai",
    "public": "dist",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/ai/chat",
        "function": "aiChat"
      },
      {
        "source": "/api/ai/stream",
        "function": "aiStream"
      },
      {
        "source": "/api/ai/image",
        "function": "aiImage"
      },
      {
        "source": "/api/ai/fetchImage",
        "function": "aiFetchImage"
      },
      {
        "source": "/api/ai/transcribe",
        "function": "aiTranscribe"
      },
      {
        "source": "/api/ai/search",
        "function": "aiSearch"
      },
      {
        "source": "/api/ai/health",
        "function": "aiHealth"
      },
      {
        "source": "/api/ai/liveness",
        "function": "aiLiveness"
      },
      {
        "source": "/api/ai/ready",
        "function": "aiReady"
      },
      {
        "source": "/api/v1/chat",
        "function": "aiChat"
      },
      {
        "source": "/api/v1/stream",
        "function": "aiStream"
      },
      {
        "source": "/api/v1/search",
        "function": "aiSearch"
      },
      {
        "source": "/api/v1/speech/transcribe",
        "function": "aiTranscribe"
      },
      {
        "source": "/api/v1/speech/synthesize",
        "function": "aiTTS"
      },
      {
        "source": "/api/v1/health",
        "function": "aiHealth"
      },
      {
        "source": "/api/ai/time",
        "function": "aiTime"
      },
      {
        "source": "/api/ai/weather",
        "function": "aiWeather"
      },
      {
        "source": "/api/v1/documents",
        "function": "v1Document"
      },
      {
        "source": "/api/v1/documents/**",
        "function": "v1Document"
      },
      {
        "source": "/api/v1/ocr",
        "function": "v1Ocr"
      },
      {
        "source": "/api/v1/vision/analyze",
        "function": "aiVision"
      },
      {
        "source": "/api/ai/vision",
        "function": "aiVision"
      },
      {
        "source": "/api/v1/image/generate",
        "function": "v1ImageGenerate"
      },
      {
        "source": "/api/v1/image/fetch",
        "function": "aiFetchImage"
      },
      {
        "source": "/api/v1/video/process",
        "function": "v1VideoProcess"
      },
      {
        "source": "/api/v1/video/status/**",
        "function": "v1VideoStatus"
      },
      {
        "source": "/api/v1/video/worker/health",
        "function": "v1VideoWorkerHealth"
      },
      {
        "source": "/api/v1/plugins",
        "function": "v1PluginRegistry"
      },
      {
        "source": "/api/v1/plugins/**",
        "function": "v1PluginRegistry"
      },
      {
        "source": "/api/v1/connectors",
        "function": "v1ConnectorRegistry"
      },
      {
        "source": "/api/v1/connectors/**",
        "function": "v1ConnectorRegistry"
      },
      {
        "source": "/api/v1/visual-orchestrator",
        "function": "v1VisualOrchestrator"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/api/**",
        "headers": [
          { "key": "Cache-Control", "value": "no-store" }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      },
      {
        "source": "/**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
          { "key": "X-XSS-Protection", "value": "1; mode=block" }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      }
    ]
  }
}
